{
  "name": "nephrite",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:performance && npm run test:ui && npm run test:plugin-compat && npm run test:dataview && npm run test:bases && npm run test:people",
    "test:ui": "node --require ./tests/node20-polyfill.cjs --import tsx --test tests/ui-interactions.test.ts",
    "test:plugin-compat": "node --require ./tests/node20-polyfill.cjs --import tsx --test tests/plugin-compat.test.ts",
    "test:plugin-real": "node --require ./tests/node20-polyfill.cjs --import tsx tools/plugin-compat-smoke.ts",
    "test:dataview": "node --require ./tests/node20-polyfill.cjs --import tsx --test tests/dataview.test.ts",
    "test:bases": "node --require ./tests/node20-polyfill.cjs --import tsx --test tests/bases.test.ts tests/air-gaps.test.ts",
    "test:people": "node --require ./tests/node20-polyfill.cjs --import tsx --test tests/people.test.ts",
    "test:performance": "esbuild tests/editor-performance.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nephrite-editor-performance.test.cjs && node --test /tmp/nephrite-editor-performance.test.cjs"
  },
  "dependencies": {
    "22": "^0.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.3.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "luxon": "^3.7.2",
    "lz-string": "^1.5.0",
    "marked": "^9.1.6",
    "mermaid": "^11.16.1",
    "node": "^26.7.0",
    "nvm": "^0.0.4",
    "pdfjs-dist": "^6.2.108",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "obsidian": "1.13.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid": "3.3.18"
  }
}
