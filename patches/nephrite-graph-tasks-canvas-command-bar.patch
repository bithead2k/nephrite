+      task.due = dueDate.value || null;
+      task.scheduled = scheduled.value || null;
+      task.priority = priority.value || null;
+      if (currentPath === task.path) await openNote(task.path, { skipDirtyPrompt: true });
+      rerender();
+    } catch (error) {
