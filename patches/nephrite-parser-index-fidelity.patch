+/// Track CommonMark fenced code blocks. Metadata-looking text inside a fence is
+/// source code, not a heading, task, field, block ID, footnote, tag, or link.
+fn update_fence_state(line: &str, fence: &mut Option<(u8, usize)>) -> bool {
+    let indent = line.as_bytes().iter().take_while(|byte| **byte == b' ').count();
+    if indent > 3 {
+        return false;
+    }
+    let rest = &line[indent..];
+    let Some(marker) = rest.as_bytes().first().copied() else {
+        return false;
+    };
+    if marker != b'`' && marker != b'~' {
+        return false;
+    }
+    let length = rest.as_bytes().iter().take_while(|byte| **byte == marker).count();
+    if length < 3 {
+        return false;
+    }
+
+    match *fence {
+        None => {
+            *fence = Some((marker, length));
+            true
+        }
+        Some((open_marker, open_length))
+            if marker == open_marker
+                && length >= open_length
+                && rest[length..].trim().is_empty() =>
+        {
+            *fence = None;
+            true
+        }
+        Some(_) => false,
+    }
+}
+
+fn is_block_id_char(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || byte == b'-'
+}
+
+fn block_id_suffix(line: &str) -> Option<(usize, &str)> {
+    let trimmed = line.trim_end();
+    let caret = trimmed.rfind('^')?;
+    if caret > 0 && !trimmed.as_bytes()[caret - 1].is_ascii_whitespace() {
+        return None;
+    }
+    let id = &trimmed[caret + 1..];
+    (!id.is_empty() && id.as_bytes().iter().all(|byte| is_block_id_char(*byte)))
+        .then_some((caret, id))
+}
+
+fn is_standalone_block_id(line: &str) -> bool {
+    block_id_suffix(line)
+        .map(|(caret, _)| line[..caret].trim().is_empty())
+        .unwrap_or(false)
+}
+
+fn extract_block_id(
+    line: &str,
+    line_start: i64,
+    line_end: i64,
+    line_no: i64,
+    previous_content_span: Option<(i64, i64, i64)>,
+) -> Option<BlockFact> {
+    let (caret, block_id) = block_id_suffix(line)?;
+    let standalone = line[..caret].trim().is_empty();
+    let (start_offset, end_offset, start_line) = if standalone {
+        previous_content_span.unwrap_or((line_start, line_end, line_no))
+    } else {
+        (line_start, line_end, line_no)
+    };
+    Some(BlockFact {
+        block_id: block_id.to_string(),
+        start_offset,
+        end_offset: Some(end_offset),
+        start_line,
+    })
+}
+
+fn parse_inline_scalar(value: &str) -> (String, Option<String>, Option<String>) {
+    let value = value.trim();
+    let parsed = parse_scalar(value);
+    match &parsed {
+        YamlVal::Null => ("null".into(), None, Some("null".into())),
+        YamlVal::Bool(value) => (
+            "boolean".into(),
+            Some(value.to_string()),
+            Some(value.to_string()),
+        ),
+        YamlVal::Num(value) => (
+            "number".into(),
+            Some(value.to_string()),
+            Some(value.to_string()),
+        ),
+        YamlVal::Str(value) => {
+            let value_type = if value.starts_with("[[") { "link" } else { "string" };
+            let json = serde_json::to_string(value).ok();
+            (value_type.into(), Some(value.clone()), json)
+        }
+        YamlVal::Map(_) | YamlVal::Arr(_) => {
+            let json = yaml_to_json(&parsed);
+            ("json".into(), Some(value.to_string()), Some(json))
+        }
+    }
+}
+
+fn valid_inline_field_key(key: &str) -> bool {
+    let key = key.trim();
+    !key.is_empty()
+        && key.len() <= 256
+        && !key
+            .chars()
+            .any(|character| matches!(character, '[' | ']' | '\n' | '\r'))
+        && key.chars().any(|character| character.is_alphanumeric())
+}
+
+fn push_inline_field(
+    key: &str,
+    value: &str,
+    line: i64,
+    start_offset: i64,
+    field_id: &mut i64,
+    facts: &mut MarkdownFacts,
+) {
+    let key = key.trim();
+    if !valid_inline_field_key(key) {
+        return;
+    }
+    let (value_type, value_text, value_json) = parse_inline_scalar(value);
+    *field_id += 1;
+    facts.inline_fields.push(InlineFieldFact {
+        field_id: *field_id,
+        key: key.to_string(),
+        value_text,
+        value_type,
+        value_json,
+        line,
+        start_offset,
+    });
+}
+
+fn extract_inline_fields(
+    line: &str,
+    line_start: i64,
+    line_no: i64,
+    field_id: &mut i64,
+    facts: &mut MarkdownFacts,
+) {
+    // Bracketed Dataview fields can occur amid ordinary prose.
+    let mut cursor = 0usize;
+    while let Some(open_rel) = line[cursor..].find('[') {
+        let open = cursor + open_rel;
+        let Some(close_rel) = line[open + 1..].find(']') else {
+            break;
+        };
+        let close = open + 1 + close_rel;
+        let inner = &line[open + 1..close];
+        if !inner.starts_with('^') {
+            if let Some((key, value)) = inner.split_once("::") {
+                push_inline_field(
+                    key,
+                    value,
+                    line_no,
+                    line_start + open as i64,
+                    field_id,
+                    facts,
+                );
+            }
+        }
+        cursor = close + 1;
+    }
+
+    // A full-line field is the other canonical Dataview spelling. Avoid
+    // treating prose containing `::` as metadata.
+    let indent = line.len() - line.trim_start().len();
+    let trimmed = line.trim_start();
+    if !trimmed.starts_with('[') {
+        if let Some((key, value)) = trimmed.split_once("::") {
+            if valid_inline_field_key(key) {
+                push_inline_field(
+                    key,
+                    value,
+                    line_no,
+                    line_start + indent as i64,
+                    field_id,
+                    facts,
+                );
+            }
+        }
+    }
+}
+
+fn valid_footnote_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= 256
+        && !id.chars().any(|character| character.is_whitespace() || character == ']')
+}
+
+fn extract_footnotes(line: &str, line_start: i64, line_no: i64, facts: &mut MarkdownFacts) {
+    let mut definition_span = None;
+    let trimmed = line.trim_start();
+    let indent = line.len() - trimmed.len();
+    if indent <= 3 && trimmed.starts_with("[^") {
+        if let Some(close) = trimmed.find("]:") {
+            let id = &trimmed[2..close];
+            if valid_footnote_id(id) {
+                facts.footnotes.push(FootnoteFact {
+                    footnote_id: id.to_string(),
+                    kind: "def".into(),
+                    text: Some(trimmed[close + 2..].trim_start().to_string()),
+                    start_offset: line_start + indent as i64,
+                    line: line_no,
+                });
+                definition_span = Some((indent, indent + close + 2));
+            }
+        }
+    }
+
+    let mut cursor = 0usize;
+    while let Some(open_rel) = line[cursor..].find("[^") {
+        let open = cursor + open_rel;
+        let Some(close_rel) = line[open + 2..].find(']') else {
+            break;
+        };
+        let close = open + 2 + close_rel;
+        let id = &line[open + 2..close];
+        let is_definition = definition_span
+            .map(|(start, end)| open >= start && close + 1 <= end)
+            .unwrap_or(false);
+        if !is_definition && valid_footnote_id(id) {
+            facts.footnotes.push(FootnoteFact {
+                footnote_id: id.to_string(),
+                kind: "ref".into(),
+                text: None,
+                start_offset: line_start + open as i64,
+                line: line_no,
+            });
+        }
+        cursor = close + 1;
+    }
+}
