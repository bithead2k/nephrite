+        assert_eq!(facts.inline_fields.len(), 4);
+        assert!(facts.inline_fields.iter().any(|field| {
+            field.key == "Estimate"
+                && field.value_type == "number"
+                && field.value_text.as_deref() == Some("12.5")
+        }));
+        assert!(facts.inline_fields.iter().any(|field| {
+            field.key == "Reviewed"
+                && field.value_type == "boolean"
+                && field.value_text.as_deref() == Some("true")
+        }));
+        assert_eq!(
+            facts
+                .footnotes
+                .iter()
+                .filter(|footnote| footnote.footnote_id == "source")
+                .count(),
+            2
+        );
+        assert!(!facts
+            .inline_fields
+            .iter()
+            .any(|field| field.key == "Fake"));
+        assert!(!facts
+            .footnotes
+            .iter()
+            .any(|footnote| footnote.footnote_id == "fake"));
+        assert!(facts.tasks.is_empty());
+        assert!(!facts.tags.iter().any(|tag| tag.tag == "fake"));
+    }
 }
